headers = libssh2.h  libssh2_publickey.h  libssh2_sftp.h
#linkerOpts.linux = -L/usr/lib -lssh2
linkerOpts.osx = -L/usr/local/lib -L/usr/lib
compilerOpts = -I./src/cinterop -fPIC



compilerOpts.osx = -I/usr/local/include/  -I/usr/include
compilerOpts.linux_x64 = -I/files/cache/xtras/lib/openssl_linuxX64_3.6.3/include/ \
                                -I/files/cache/xtras/lib/ssh2_linuxX64_libssh2-1.11.1/include/
linkerOpts.linux_x64 = -L/files/cache/xtras/lib/openssl_linuxX64_3.6.3/lib/ \
                            -L/files/cache/xtras/lib/ssh2_linuxX64_libssh2-1.11.1/lib/ -lssh2
compilerOpts.linux_arm64 = -I/files/cache/xtras/lib/openssl_linuxArm64_3.6.3/include/ \
    -I/files/cache/xtras/lib/ssh2_linuxArm64_libssh2-1.11.1/include/
linkerOpts.linux_arm64 = -L/files/cache/xtras/lib/openssl_linuxArm64_3.6.3/lib/ \
                            -L/files/cache/xtras/lib/ssh2_linuxArm64_libssh2-1.11.1/lib/ -lssh2
linkerOpts.osx = -L/usr/local/lib  -lssh2
compilerOpts.android_x64 = -I/files/workspace/knativedemos/kssh2/app/libs/x86_64/
compilerOpts.android_arm64 = -I/files/workspace/knativedemos/kssh2/app/libs/arm64-v8a/
linkerOpts.android_x64 = -L/files/workspace/knativedemos/kssh2/app/libs/x86_64/ -lssh2
linkerOpts.android_arm64 = -L/files/workspace/knativedemos/kssh2/app/libs/arm64-v8a/ -lssh2

---

#include <libssh2.h>
#include <stddef.h>
#include <string.h>
#include <unistd.h>
#include <sys/stat.h>
#include <stdio.h>
#include <sys/types.h>

#ifndef _WIN32

#include <arpa/inet.h>
#include <sys/socket.h>
#endif

#include "ssh_sockets.h"

static int kssh2_init(int flags) {
    int rc = 0;
#ifdef _WIN32
    WSADATA wsadata;

    rc = WSAStartup(MAKEWORD(2, 0), &wsadata);
    if(rc) {
        fprintf(stderr, "WSAStartup failed with error: %d\n", rc);
        return 1;
    }
#endif

    return libssh2_init(flags);
}

static int kssh2_exit() {
    libssh2_exit();
#ifdef _WIN32
    WSACleanup();
#endif
}

